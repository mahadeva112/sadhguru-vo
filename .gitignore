# Virtual environment
.venv/
__pycache__/
*.py[cod]

# Credentials and machine-local config — DO NOT COMMIT
api.txt
llm_settings.json
vertex_key.json
*_key.json

# User state (voice/model choices, starred voices)
sadhguru_vo_prefs.json
fav_voices.json

# Studio-specific voice config — the voice ids and speaker names a given
# installation uses. Ship voices.example.json / cast.example.json instead.
voices.local.json
cast.json
*.bak-*

# Generated shortcut (recreate with make_shortcut.ps1 — it embeds absolute paths)
*.lnk

# Runtime output
error_log.txt
*_chunks.txt
*_chunk_[0-9][0-9].mp3
*_step1_sadhguru.mp3

# Audio output
*.mp3
*.wav
!assets/*
